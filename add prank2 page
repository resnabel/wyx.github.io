<!DOCTYPE html>
<html lang="zh-CN">

<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Security Center</title>

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:"Microsoft YaHei",Arial;
}


body{

height:100vh;
background:#050505;
color:#00ff66;

display:flex;
justify-content:center;
align-items:center;

}



.box{

width:90%;
max-width:420px;

background:#111;

padding:35px;

border-radius:12px;

border:1px solid #00ff66;

box-shadow:0 0 25px rgba(0,255,100,.4);

text-align:center;

}



h1,h2{

margin-bottom:20px;

}



p{

line-height:1.8;

margin:15px 0;

}



input{

width:100%;

padding:14px;

background:#000;

color:#00ff66;

border:1px solid #00ff66;

font-size:18px;

}



button{

margin-top:20px;

width:100%;

padding:14px;

background:#00ff66;

border:0;

font-size:18px;

cursor:pointer;

}



#result{

display:none;

}



.loader{

width:45px;

height:45px;

border-radius:50%;

border:5px solid #333;

border-top-color:#00ff66;

margin:20px auto;

animation:spin 1s linear infinite;

}



@keyframes spin{

from{

transform:rotate(0deg);

}

to{

transform:rotate(360deg);

}

}



.progress{

width:100%;

height:15px;

background:#333;

border-radius:10px;

overflow:hidden;

}



.bar{

height:100%;

width:0%;

background:#00ff66;

}



#failed{

display:none;

color:red;

}



#failed button{

background:red;

color:white;

}



#reason{

display:none;

}



.reason{

font-size:22px;

color:red;

line-height:2;

}



.small{

font-size:12px;

color:#aaa;

margin-top:25px;

}


</style>

</head>



<body>


<div class="box">


<div id="login">

<h1>
安全检测中心
</h1>


<p>
请输入手机号进行身份认证
</p>


<input placeholder="请输入任意数字">


<button onclick="start()">
开始验证
</button>


</div>




<div id="result">


<h2>
认证成功
</h2>


<div class="loader"></div>


<p id="text">
正在连接服务器...
</p>


<div class="progress">

<div class="bar" id="bar"></div>

</div>


</div>





<div id="failed">


<h2>
UPLOAD FAILED
</h2>


<p>
错误代码：WYXSQ-404
</p>


<button onclick="showReason()">

查看错误信息

</button>


</div>





<div id="reason">


<div class="reason">

我直接给你开了你气不气

<br>

姓名：马俊杰

<br>

身份证号：510922200603305895

<br>

<span class="small">

v我50保你平安。

</span>

</div>


</div>



</div>





<script>


function start(){


document.getElementById("login").style.display="none";


document.getElementById("result").style.display="block";



let text=document.getElementById("text");

let bar=document.getElementById("bar");



let steps=[

"正在分析设备环境...",

"正在读取聊天记录...",

"正在检测相册信息...",

"正在检查安全状态...",

"正在建立数据连接..."

];



let i=0;

let progress=0;



let timer=setInterval(()=>{


progress += Math.floor(Math.random()*10)+5;


if(progress>=100){

progress=100;

}


bar.style.width=progress+"%";



if(i<steps.length){

text.innerHTML=steps[i];

i++;

}



if(progress>=100){


clearInterval(timer);


setTimeout(()=>{


document.getElementById("result").style.display="none";


document.getElementById("failed").style.display="block";


},800);



}



},1000);



}





function showReason(){


document.getElementById("failed").style.display="none";


document.getElementById("reason").style.display="block";


}



</script>


</body>

</html>
